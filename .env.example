DATABASE_URL=postgresql://kalshi:kalshi@localhost:5432/kalshi_bet
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
PRICE_FEED=coinbase
COINBASE_PRODUCT_ID=BTC-USD
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_REST_BASE=https://api.binance.com
LOG_LEVEL=info
SNAPSHOT_INTERVAL_MS=1000
KALSHI_POLL_INTERVAL_MS=2000
MINIMUM_EDGE=0.07
MINIMUM_CONFIDENCE=0.70
MAXIMUM_SPREAD=0.08
MINIMUM_SECONDS_REMAINING=90
BINANCE_STALE_MS=3000
KALSHI_STALE_MS=5000
PAPER_TRADING=false
SLIPPAGE_CENTS=0.01
TAKER_FEE_COEFFICIENT=0.07
API_PORT=3001
API_HOST=0.0.0.0
# Forces a directional forecast only — never bypasses trade safety checks.
ALWAYS_PICK_SIDE=true

# Analytical prediction cadence
ANALYTICAL_PREDICTION_INTERVAL_MS=2000
ANALYTICAL_PRICE_CHANGE_BPS=2
ANALYTICAL_BOOK_CHANGE=0.01

# Monte Carlo (runs in a worker thread)
MONTE_CARLO_ENABLED=true
MONTE_CARLO_INTERVAL_NORMAL_MS=30000
MONTE_CARLO_INTERVAL_ACTIVE_MS=10000
MONTE_CARLO_INTERVAL_FINAL_MS=3000
MONTE_CARLO_ACTIVE_THRESHOLD_SECONDS=300
MONTE_CARLO_FINAL_THRESHOLD_SECONDS=90
MONTE_CARLO_PATHS_FREQUENT=2000
MONTE_CARLO_PATHS_NORMAL=5000
MONTE_CARLO_PATHS_FINAL=10000
MONTE_CARLO_MAX_RUNTIME_MS=2000
MONTE_CARLO_SHOCK_DISTRIBUTION=student-t
MONTE_CARLO_STUDENT_T_DF=5
MONTE_CARLO_SETTLEMENT_WINDOW_SECONDS=60

# Persistence / retention (Pi-friendly)
PREDICTION_PERSIST_INTERVAL_MS=5000
RAW_TICK_RETENTION_DAYS=7
ONE_SECOND_BAR_RETENTION_DAYS=90
PREDICTION_RETENTION_DAYS=365
RETENTION_CLEANUP_INTERVAL_MS=3600000
