DATABASE_URL=postgresql://kalshi:kalshi@localhost:5432/kalshi_bet
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
PRICE_FEED=coinbase
COINBASE_PRODUCT_ID=BTC-USD
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_REST_BASE=https://api.binance.com
LOG_LEVEL=info
SNAPSHOT_INTERVAL_MS=1000
KALSHI_POLL_INTERVAL_MS=2000
# Edge ladder, in dollars per contract, after fees and slippage. A bet is
# graded LEAN / MODERATE / STRONG as it clears each rung, and the grade sets the
# stake rather than gating the bet.
MINIMUM_EDGE=0.01
MODERATE_EDGE=0.03
STRONG_EDGE=0.06

# Minimum P(edge > 0) required at each rung, from the probability standard error.
MINIMUM_EDGE_CERTAINTY=0.55
MODERATE_EDGE_CERTAINTY=0.65
STRONG_EDGE_CERTAINTY=0.75

# Execution limits. These are the only conditions that can force a pass.
MAXIMUM_SPREAD=0.15
MINIMUM_SECONDS_REMAINING=20
MINIMUM_LIQUIDITY=10
BINANCE_STALE_MS=3000
KALSHI_STALE_MS=5000

# Position sizing. Fractional Kelly on the uncertainty-discounted edge, capped.
ASSUMED_ORDER_SIZE=20
KELLY_MULTIPLIER=0.25
MAXIMUM_STAKE_FRACTION=0.02
MINIMUM_STAKE_FRACTION=0.002

# How much the probability estimate is trusted. VOL_RELATIVE_ERROR is the
# typical error in the realized-vol estimate; MODEL_ERROR_FLOOR covers fat tails
# and the basis between our spot feed and the BRTI average that settles.
VOL_RELATIVE_ERROR=0.30
DRIFT_UNCERTAINTY_SHARE=0.70
MODEL_ERROR_FLOOR=0.02

PAPER_TRADING=false
PAPER_BANKROLL=1000
SLIPPAGE_CENTS=0.01
TAKER_FEE_COEFFICIENT=0.07
API_PORT=3001
API_HOST=0.0.0.0
# Adds an explicit "if forced to pick a side" note when passing. Never bypasses
# the execution blockers.
ALWAYS_PICK_SIDE=true

# Analytical prediction cadence
ANALYTICAL_PREDICTION_INTERVAL_MS=2000
ANALYTICAL_PRICE_CHANGE_BPS=2
ANALYTICAL_BOOK_CHANGE=0.01

# Monte Carlo (runs in a worker thread)
MONTE_CARLO_ENABLED=true
MONTE_CARLO_INTERVAL_NORMAL_MS=30000
MONTE_CARLO_INTERVAL_ACTIVE_MS=10000
MONTE_CARLO_INTERVAL_FINAL_MS=3000
MONTE_CARLO_ACTIVE_THRESHOLD_SECONDS=300
MONTE_CARLO_FINAL_THRESHOLD_SECONDS=90
MONTE_CARLO_PATHS_FREQUENT=2000
MONTE_CARLO_PATHS_NORMAL=5000
MONTE_CARLO_PATHS_FINAL=10000
MONTE_CARLO_MAX_RUNTIME_MS=2000
MONTE_CARLO_SHOCK_DISTRIBUTION=student-t
MONTE_CARLO_STUDENT_T_DF=5
MONTE_CARLO_SETTLEMENT_WINDOW_SECONDS=60

# Persistence / retention (Pi-friendly)
PREDICTION_PERSIST_INTERVAL_MS=5000
RAW_TICK_RETENTION_DAYS=7
ONE_SECOND_BAR_RETENTION_DAYS=90
PREDICTION_RETENTION_DAYS=365
RETENTION_CLEANUP_INTERVAL_MS=3600000
